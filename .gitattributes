# 统一换行符：仓库内一律 LF，避免 Windows 协作者引入 CRLF 造成整文件 diff
* text=auto eol=lf

# 明确二进制类型，防止 git 尝试做文本 diff 或 eol 转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.apk  binary
*.aab  binary
*.keystore binary
*.jks  binary
*.woff  binary
*.woff2 binary
*.ttf  binary

# shell 脚本必须保持 LF —— CRLF 会让 macOS/Linux 上的 shebang 直接失效
*.sh text eol=lf

# 锁文件折叠在 diff 里，减少评审噪音
package-lock.json -diff
